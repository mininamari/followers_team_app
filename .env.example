FOLLOWERS_ADMIN_USERNAME=replace-with-admin-username
FOLLOWERS_ADMIN_PASSWORD=replace-with-strong-admin-password
FOLLOWERS_DB_PATH=data/followers_team.db
# Railway injects this reference after PostgreSQL is linked. Leave empty for local SQLite.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
FOLLOWERS_UPLOAD_DIR=data/uploads
FOLLOWERS_BACKUP_DIR=backups
FOLLOWERS_BACKUP_RETENTION=8
FOLLOWERS_BACKUP_INTERVAL_DAYS=7

# Facebook Marketing API (optional, see README "Facebook Ads integration")
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
